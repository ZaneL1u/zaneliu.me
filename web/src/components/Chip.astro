---
interface Props {
  name: string
  href?: string
  /** 站内图片地址；`mask:` 开头表示单色图标，用文字颜色着色 */
  icon?: string
  /** 名字后面的小字说明 */
  note?: string
}

const { name, href, icon, note } = Astro.props
const Tag = href ? 'a' : 'span'
const mask = icon?.startsWith('mask:') ? icon.slice(5) : undefined
---

<Tag
  class:list={['chip', { 'is-link': href }]}
  href={href}
  target={href ? '_blank' : undefined}
  rel={href ? 'noopener' : undefined}
>
  {
    icon && (mask
      ? <span class="chip-icon chip-mask" style={`--icon: url(${mask})`} aria-hidden="true" />
      : <img class="chip-icon" src={icon} alt="" width="18" height="18" loading="lazy" decoding="async" />)
  }
  <span>{name}</span>
  {note && <span class="chip-note">{note}</span>}
  <slot />
</Tag>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.32em 0.75em 0.32em 0.5em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--chip);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: 0.9rem;
    line-height: 1.3;
    white-space: nowrap;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .chip.is-link:hover {
    background: var(--chip-hover);
    box-shadow: var(--shadow);
    transform: translateY(-1px);
  }

  .chip-icon {
    width: 1.15em;
    height: 1.15em;
    flex: none;
    border-radius: 4px;
    object-fit: contain;
  }

  .chip-mask {
    border-radius: 0;
    background: currentColor;
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }

  .chip-note {
    color: var(--faint);
    font-size: 0.85em;
  }
</style>
