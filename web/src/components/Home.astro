---
import type { Lang } from '../i18n'
import { COVERS, ICONS, loadContent } from '../content'
import { COPY } from '../i18n'
import Base from '../layouts/Base.astro'
import Activity from './Activity.astro'
import Chip from './Chip.astro'
import Plum from './Plum.astro'
import Toolbar from './Toolbar.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = COPY[lang]
// 文案和列表来自 dashboard（构建时取，失败用默认值）；界面上的固定标签仍在 i18n.ts
const c = await loadContent()
const tx = (v: { en: string, zh: string }) => v[lang]
const icon = (key: string) => ICONS[key]
const intro = c.intro

const openSource = c.open_source.map(x => ({ name: x.name, href: x.href, icon: icon(x.icon) }))
const languages = c.languages.map(x => ({ name: x.name, icon: icon(x.icon) }))
const aiTools = c.ai_tools.map(x => ({ name: x.name, icon: icon(x.icon) }))
const life = c.life.map(x => ({ name: tx(x.name), icon: icon(x.icon), note: x.note ? tx(x.note) : undefined }))
const pets = c.pets.map(x => ({ name: x.name, kind: tx(x.kind), icon: icon(x.icon) }))
const g = t.games
const hoursText = (n: number) => g.hours.replace('{n}', lang === 'zh' ? String(n) : n.toLocaleString('en-US'))
const games = c.games
  .filter(x => COVERS[x.cover])
  .map(x => ({
    name: tx(x.name),
    key: x.cover,
    cover: COVERS[x.cover],
    note: x.note ? tx(x.note) : undefined,
    hours: x.hours ? hoursText(x.hours) : undefined,
    href: x.href?.startsWith('https://') ? x.href : undefined,
  }))
const p = c.personality
const report = p.report
---

<Base lang={lang} title={tx(intro.title)} description={tx(intro.description)}>
  <Toolbar lang={lang} />
  <main class="page">
    <header class="hero reveal" data-section="hero">
      <img class="avatar" src="/avatar.jpg" alt="Zane Liu" width="88" height="88" />
      <h1 class="serif">
        {intro.hello[lang][0]}<em>Zane</em>{intro.hello[lang][1]}
      </h1>
      <p class="lead">{tx(intro.lead)}</p>
      <nav class="social" aria-label={t.contact}>
        <a class="btn" href="https://github.com/ZaneL1u" target="_blank" rel="noopener me" data-track="github">
          <span class="i-simple-icons-github" aria-hidden="true"></span> GitHub
        </a>
        <a class="btn" href="mailto:hi@zaneliu.me" data-track="email">
          <span class="i-ph-envelope-simple" aria-hidden="true"></span> hi@zaneliu.me
        </a>
        <button class="btn" type="button" data-dialog="wechat" data-track="wechat" aria-haspopup="dialog">
          <span class="i-ph-wechat-logo" aria-hidden="true"></span> {t.wechat.label}
        </button>
      </nav>
    </header>

    <section class="reveal" style="--d: 1" data-section="work">
      <h2>{t.work.title}</h2>
      <p>
        {tx(intro.work_before)}
        <Chip name={c.company.name} href={c.company.href} icon={icon(c.company.icon)} />{tx(intro.work_after)}
      </p>
      <div class="chips">
        {openSource.map(item => <Chip {...item} />)}
      </div>
    </section>

    <section class="reveal" style="--d: 2" data-section="personality">
      <h2>{t.personality.title}</h2>
      <div class="mbti">
        <div class="mbti-head">
          <div>
            <div class="mbti-type serif">{p.type}</div>
            <div class="mbti-name">{tx(p.name)}</div>
          </div>
          <button class="btn btn-sm" type="button" data-dialog="mbti" data-track="mbti-details" aria-haspopup="dialog">
            {t.personality.details} <span class="i-ph-arrow-up-right" aria-hidden="true"></span>
          </button>
        </div>
        <ul class="axes">
          {
            p.axes.map(a => (
              <li class="axis">
                <span class="axis-side">
                  <b>{a.letter}</b> {tx(a.label)} <span class="axis-pct">{a.percent}%</span>
                </span>
                <span class="axis-bar" role="img" aria-label={`${tx(a.label)} ${a.percent}% / ${tx(a.other_label)} ${100 - a.percent}%`}>
                  <span style={`width: ${Math.min(100, Math.max(0, a.percent))}%`}></span>
                </span>
                <span class="axis-side axis-other">
                  <span class="axis-pct">{100 - a.percent}%</span> <span class="axis-word">{tx(a.other_label)}</span> <b>{a.other_letter}</b>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="reveal" style="--d: 2" data-section="tools">
      <h2>{t.tools.title}</h2>
      <div class="tool-row">
        <span class="tool-label">{t.tools.languages}</span>
        <div class="chips">
          {languages.map(item => <Chip {...item} />)}
        </div>
      </div>
      <div class="tool-row">
        <span class="tool-label">{t.tools.ai}</span>
        <div class="chips">
          {aiTools.map(item => <Chip {...item} />)}
        </div>
      </div>
    </section>

    <Activity lang={lang} />

    <section class="reveal" style="--d: 3" data-section="life">
      <h2>{t.life.title}</h2>
      <div class="chips">
        {life.map(item => <Chip {...item} />)}
      </div>
      <div class="pets">
        {
          pets.map(pet => (
            <div class="pet">
              <img class="pet-icon" src={pet.icon} alt="" width="44" height="44" loading="lazy" decoding="async" />
              <div>
                <div class="pet-name">{pet.name}</div>
                <div class="pet-kind">{pet.kind}</div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="reveal" style="--d: 4" data-section="games">
      <h2>{g.title}</h2>
      <ul class="games">
        {
          games.map(game => (
            <li class="game">
              {
                (() => {
                  const Tag = game.href ? 'a' : 'div'
                  return (
                    <Tag
                      class="game-body"
                      href={game.href}
                      target={game.href ? '_blank' : undefined}
                      rel={game.href ? 'noopener' : undefined}
                      aria-label={game.href ? `${game.name} · ${g.steam}` : undefined}
                      data-track={`game-${game.key}`}
                    >
                      <div class="cover">
                        <img src={game.cover} alt="" width="360" height="540" loading="lazy" decoding="async" />
                        {game.note && <span class="game-note">{game.note}</span>}
                        {game.href && <span class="game-steam i-simple-icons-steam" aria-hidden="true" />}
                      </div>
                      <span class="game-name">{game.name}</span>
                      {game.hours && <span class="game-hours">{game.hours}</span>}
                    </Tag>
                  )
                })()
              }
            </li>
          ))
        }
      </ul>
    </section>

    <footer class="reveal" style="--d: 5" data-section="footer">
      <p class="serif sign-off">{tx(intro.sign_off)}</p>
      <p class="fine">© {new Date().getFullYear()} Zane Liu</p>
      <!-- 统计说明：两种语言的页面都用这一句英文，不走 i18n -->
      <p class="privacy">
        This site keeps anonymous visit stats (page views, time on page, clicks, IP-based location and a hashed browser
        fingerprint), used only to count visits. Nothing is shared or sold.{' '}
        <a href="?notrack=1" data-track="opt-out" rel="nofollow">Opt out</a>
      </p>
    </footer>
  </main>

  <dialog class="sheet sheet-qr" id="wechat" aria-labelledby="wechat-title" data-section="dialog-wechat">
    <button class="sheet-close" type="button" data-close data-track="close" aria-label={t.close}>
      <span class="i-ph-x" aria-hidden="true"></span>
    </button>
    <h2 class="sheet-title serif" id="wechat-title">{t.wechat.title}</h2>
    <div class="qr">
      <img class="qr-light" src="/wechat-qr-light.png" alt={t.wechat.scan} width="240" height="240" loading="lazy" decoding="async" />
      <img class="qr-dark" src="/wechat-qr-dark.png" alt={t.wechat.scan} width="240" height="240" loading="lazy" decoding="async" />
    </div>
    <p class="qr-scan">{t.wechat.scan}</p>
    <p class="qr-hint">{t.wechat.longPress}</p>
  </dialog>

  <dialog class="sheet" id="mbti" aria-labelledby="mbti-title" data-section="dialog-mbti">
    <button class="sheet-close" type="button" data-close data-track="close" aria-label={t.close}>
      <span class="i-ph-x" aria-hidden="true"></span>
    </button>
    <h2 class="sheet-title serif" id="mbti-title">{tx(report.title)}</h2>
    <p class="sheet-intro">{tx(report.intro)}</p>
    {
      report.sections.map(sec => (
        <div class="report-sec">
          <h3>{tx(sec.title)}</h3>
          <p>{tx(sec.body)}</p>
        </div>
      ))
    }
    <p class="fine">{tx(report.footnote)}</p>
  </dialog>

  <Plum />
</Base>

<script>
  // 弹窗：带 data-dialog 的按钮打开对应 <dialog>；点关闭按钮或弹窗外的遮罩关闭
  for (const btn of document.querySelectorAll<HTMLElement>('[data-dialog]')) {
    const dlg = document.getElementById(btn.dataset.dialog ?? '')
    if (dlg instanceof HTMLDialogElement)
      btn.addEventListener('click', () => dlg.showModal())
  }
  for (const dlg of document.querySelectorAll('dialog')) {
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg || (e.target as Element).closest('[data-close]'))
        dlg.close()
    })
  }
</script>

<style>
  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: max(12vh, 3rem) 1.5rem calc(4rem + env(safe-area-inset-bottom));
  }

  /* ---------- hero ---------- */
  .avatar {
    display: block;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow:
      0 0 0 4px var(--bg),
      0 0 0 5px var(--line),
      var(--shadow);
  }

  h1 {
    margin: 1.75rem 0 0.75rem;
    font-size: clamp(2.75rem, 9vw, 4.25rem);
    line-height: 1.02;
  }

  :global(html[data-lang='zh']) h1 {
    font-size: clamp(2.25rem, 8.6vw, 4rem);
  }

  h1 em {
    font-style: italic;
    color: var(--accent);
  }

  .lead {
    margin: 0;
    max-width: 34em;
    font-size: 1.125rem;
    color: var(--muted);
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 40px;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--chip);
    font-size: 0.925rem;
    font-weight: 500;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .btn:hover {
    background: var(--chip-hover);
    box-shadow: var(--shadow);
    transform: translateY(-1px);
  }

  /* ---------- sections ---------- */

  section p :global(.chip) {
    vertical-align: -0.3em;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  /* ---------- pets ---------- */
  .pets {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .pet {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--chip);
  }

  .pet-icon {
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .pet:hover .pet-icon {
    transform: rotate(-8deg) scale(1.08);
  }

  .pet-name {
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
  }

  .pet-kind {
    font-size: 0.85rem;
    color: var(--faint);
  }

  /* ---------- tools ---------- */
  .tool-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .tool-label {
    flex: none;
    width: 5.5rem;
    font-size: 0.82rem;
    color: var(--faint);
  }

  /* ---------- games ---------- */
  .games {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.1rem 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .game {
    min-width: 0;
  }

  .cover {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 10px;
    background: var(--line);
    box-shadow: var(--shadow);
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.25s ease;
  }

  .cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .game-body:hover .cover {
    transform: translateY(-3px) rotate(-0.6deg);
    box-shadow: 0 2px 4px #0000001a, 0 14px 28px -12px #00000059;
  }

  .game-name {
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .game-note {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    padding: 0.1em 0.5em;
    border-radius: 999px;
    background: #000000a6;
    color: #fff;
    font-size: 0.7rem;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .game-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  a.game-body:hover .game-name {
    color: var(--accent);
  }

  .game-hours {
    margin-top: -0.35rem;
    font-size: 0.75rem;
    color: var(--faint);
  }

  .game-steam {
    position: absolute;
    right: 0.45rem;
    bottom: 0.45rem;
    width: 1.1rem;
    height: 1.1rem;
    color: #fff;
    opacity: 0;
    filter: drop-shadow(0 1px 2px #0009);
    transition: opacity 0.2s ease;
  }

  a.game-body:hover .game-steam,
  a.game-body:focus-visible .game-steam {
    opacity: 0.95;
  }

  /* ---------- personality ---------- */
  .mbti {
    padding: 1.1rem 1.25rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--chip);
  }

  .mbti-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .mbti-type {
    font-size: 2.4rem;
    line-height: 1;
    color: var(--accent);
  }

  .mbti-name {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .btn-sm {
    min-height: 32px;
    padding: 0 0.8rem;
    font-size: 0.85rem;
    color: inherit;
    font-family: inherit;
    cursor: pointer;
  }

  .axes {
    display: grid;
    grid-template-columns: max-content 1fr max-content;
    gap: 0.55rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .axis {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .axis-side b {
    font-weight: 600;
  }

  .axis-pct {
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .axis-other {
    text-align: right;
    color: var(--faint);
  }

  .axis-other .axis-pct {
    color: var(--faint);
  }

  .axis-bar {
    height: 6px;
    border-radius: 999px;
    background: var(--line);
    overflow: hidden;
  }

  .axis-bar > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
  }

  /* ---------- dialogs ---------- */
  .sheet {
    width: min(560px, calc(100vw - 2rem));
    max-height: min(84vh, 760px);
    margin: auto;
    padding: 1.75rem 1.75rem 1.5rem;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 24px 60px -20px #0000008c;
    overscroll-behavior: contain;
  }

  .sheet[open] {
    animation: sheet-in 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .sheet::backdrop {
    background: #0000004d;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet[open] {
      animation: none;
    }
  }

  .sheet-close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 50%;
    background: var(--chip);
    color: var(--muted);
    cursor: pointer;
  }

  .sheet-close:hover {
    background: var(--chip-hover);
    color: var(--fg);
  }

  .sheet-title {
    margin: 0 2rem 0.75rem 0;
    font-size: 2rem;
    line-height: 1.1;
  }

  .sheet-intro {
    margin: 0 0 1.25rem;
    color: var(--muted);
  }

  .report-sec h3 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .report-sec p {
    margin: 0.2rem 0 1rem;
  }

  .sheet-qr {
    width: min(340px, calc(100vw - 2rem));
    text-align: center;
  }

  .sheet-qr .sheet-title {
    margin-right: 0;
  }

  .qr img {
    display: block;
    width: 240px;
    height: 240px;
    margin: 0 auto;
    border-radius: 14px;
  }

  .qr-dark {
    display: none !important;
  }

  :global(:root[data-theme='dark']) .qr-light {
    display: none !important;
  }

  :global(:root[data-theme='dark']) .qr-dark {
    display: block !important;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .qr-light {
      display: none !important;
    }

    :global(:root:not([data-theme='light'])) .qr-dark {
      display: block !important;
    }
  }

  .qr-scan {
    margin: 0.9rem 0 0;
    font-weight: 500;
  }

  .qr-hint {
    margin: 0.1rem 0 0;
    font-size: 0.8rem;
    color: var(--faint);
  }

  /* ---------- footer ---------- */
  footer {
    margin-top: 4.5rem;
  }

  .sign-off {
    margin: 0;
    font-size: 2rem;
    font-style: italic;
  }

  .fine {
    margin: 0.25rem 0 0;
    font-size: 0.8rem;
    color: var(--faint);
  }

  .privacy {
    max-width: 36rem;
    margin: 0.9rem 0 0;
    font-size: 0.72rem;
    line-height: 1.55;
    color: var(--faint);
    opacity: 0.6;
  }

  .privacy a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .privacy a:hover {
    color: var(--muted);
  }


  /* ---------- small screens ---------- */
  @media (max-width: 480px) {
    .page {
      padding-top: 3.5rem;
      padding-inline: 1.25rem;
    }

    .avatar {
      width: 72px;
      height: 72px;
    }

    .lead {
      font-size: 1.05rem;
    }

    .games {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem 0.65rem;
    }

    .axes {
      column-gap: 0.6rem;
    }

    .axis {
      font-size: 0.8rem;
    }

    .axis-other .axis-word {
      display: none;
    }

    .mbti {
      padding: 1rem;
    }

    .sheet {
      padding: 1.5rem 1.25rem 1.25rem;
    }

    .tool-row {
      flex-direction: column;
      gap: 0.35rem;
    }

    .pet {
      padding: 0.75rem;
    }

    .pet-icon {
      width: 2.25rem;
      height: 2.25rem;
    }
  }
</style>
