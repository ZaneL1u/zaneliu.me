---
import type { Lang } from '../i18n'
import { loadProfile, PROFILE_API } from '../activity/load'
import { createView } from '../activity/view'

interface Props {
  lang: Lang
}

// 代码贡献 / AI 用量 / AI 日报 / 开源贡献。数据来自 dashboard 的公开接口（只有脱敏后的聚合数字，只到昨天）。
// 构建时取一次，直接渲染进 HTML（搜索引擎、无脚本都能看到），同一份数据嵌进页面给交互用，浏览器不再请求接口。
// 构建时取不到数据：整块先隐藏，浏览器里现取再渲染（兜底）。
const api = PROFILE_API
const { lang } = Astro.props
const profile = await loadProfile()
const view = profile ? createView(lang).build(profile, Date.now()) : null
const slots = view?.slots ?? {}
const html = (k: string) => slots[k]?.html ?? ''
const text = (k: string) => slots[k]?.text ?? ''
const hidden = (k: string, dflt = false) => slots[k]?.hidden ?? dflt
// 嵌进 <script type="application/json">：把 < 转义，避免数据里出现 </script> 截断
const embedded = profile ? JSON.stringify(profile).replace(/</g, '\\u003c') : ''

const TEXT = {
  en: {
    codeTitle: 'Contributions',
    codeNote: 'GitHub contributions are public. Private repos live on my self-hosted Gitea and are counted only.',
    aiTitle: 'AI, by the numbers',
    aiNote: 'I pair with AI coding agents every day. These are live numbers from my main machine, aggregated per day. No prompts, code or project names ever leave it.',
    logTitle: 'AI daily log',
    modelsTitle: 'Models',
    modelsNote: 'Tokens by model across everything I run: my own sessions, agents on my machines, and the platforms I host (Friday, LoopForge).',
    allTime: 'All time',
    last30: 'Last 30 days',
    ossTitle: 'Open source',
    ossNote: 'My own open source projects and the ones I\'ve contributed to, newest first.',
    activityTitle: 'Recent activity',
    less: 'Less',
    more: 'More',
    years: 'Year',
  },
  zh: {
    codeTitle: '代码贡献',
    codeNote: 'GitHub 为公开贡献；私有存储库是自建 Gitea 上的私有仓库，这里只统计次数。',
    aiTitle: 'AI 用量',
    aiNote: '我每天都和 AI 编程助手一起写代码。下面是主力机上的实时数据，按天汇总；对话内容、代码和项目名称都不会离开那台机器。',
    logTitle: 'AI 日报',
    modelsTitle: '模型消耗',
    modelsNote: '按模型统计的 token：包括我自己的会话、跑在我机器上的代理，以及我部署的平台（Friday、LoopForge）。',
    allTime: '全部',
    last30: '近 30 天',
    ossTitle: '参与的开源项目',
    ossNote: '我自己的开源项目，以及参与贡献过的项目，按时间从近到远。',
    activityTitle: '最近动态',
    less: '少',
    more: '多',
    years: '年份',
  },
}[lang]
---

<div class="activity" data-api={api} data-lang={lang} hidden={!view}>
  {embedded && <script type="application/json" data-activity set:html={embedded} />}
  <section class="reveal" style="--d: 3" data-section="code">
    <h2>{TEXT.codeTitle}</h2>
    <div class="stats three" data-slot="code-stats" set:html={html('code-stats')} />
    <figure class="heat-wrap">
      <div class="tabs" role="tablist" aria-label={TEXT.years} data-slot="code-tabs" set:html={html('code-tabs')} />
      <div class="heat" data-slot="code-heat" set:html={html('code-heat')} />
      <figcaption>
        <span data-slot="code-caption">{text('code-caption')}</span>
        <span class="legend" aria-hidden="true">
          {TEXT.less} <i data-l="0"></i><i data-l="1"></i><i data-l="2"></i><i data-l="3"></i><i data-l="4"></i> {TEXT.more}
        </span>
      </figcaption>
      <p class="fine-note">{TEXT.codeNote}</p>
    </figure>
    <div class="feed-wrap" data-slot="feed-wrap" hidden={hidden('feed-wrap', true)}>
      <h3 class="sub">{TEXT.activityTitle}</h3>
      <ul class="feed" data-slot="feed" set:html={html('feed')} />
    </div>
  </section>

  <section class="reveal" style="--d: 4" data-section="ai">
    <h2>{TEXT.aiTitle}</h2>
    <p class="note">{TEXT.aiNote}</p>
    <div class="stats" data-slot="ai-stats" set:html={html('ai-stats')} />
    <div class="split" data-slot="split" set:html={html('split')} />
    <figure class="heat-wrap">
      <div class="tabs" role="tablist" aria-label={TEXT.years} data-slot="ai-tabs" set:html={html('ai-tabs')} />
      <div class="heat" data-slot="ai-heat" set:html={html('ai-heat')} />
      <figcaption>
        <span data-slot="ai-caption">{text('ai-caption')}</span>
        <span class="legend" aria-hidden="true">
          {TEXT.less} <i data-l="0"></i><i data-l="1"></i><i data-l="2"></i><i data-l="3"></i><i data-l="4"></i> {TEXT.more}
        </span>
      </figcaption>
      <p class="fine-note" data-slot="ai-since">{text('ai-since')}</p>
    </figure>
  </section>

  <section class="reveal" style="--d: 5" data-slot="models-section" data-section="models" hidden={hidden('models-section', true)}>
    <h2>{TEXT.modelsTitle}</h2>
    <p class="note">{TEXT.modelsNote}</p>
    <div class="tabs" role="tablist" data-slot="models-tabs">
      <button type="button" role="tab" data-range="all" aria-selected="true">{TEXT.allTime}</button>
      <button type="button" role="tab" data-range="month" aria-selected="false">{TEXT.last30}</button>
    </div>
    <div class="sources" data-slot="models-sources" set:html={html('models-sources')} />
    <ol class="models" data-slot="models" set:html={html('models')} />
    <p class="fine-note" data-slot="embeddings">{text('embeddings')}</p>
  </section>

  <section class="reveal" style="--d: 5" data-section="log">
    <h2>{TEXT.logTitle}</h2>
    <ol class="log" data-slot="log" set:html={html('log')} />
  </section>

  <section class="reveal" style="--d: 6" data-slot="oss-section" data-section="oss" hidden={hidden('oss-section')}>
    <h2>{TEXT.ossTitle}</h2>
    <p class="note">{TEXT.ossNote}</p>
    <ol class="timeline" data-slot="timeline" set:html={html('timeline')} />
    <button type="button" class="more" data-slot="more" hidden={hidden('more', true)}>{text('more')}</button>
  </section>
</div>

<style>
  .activity {
    --h0: #1d1c1a0f;
    --h1: #c6e9b4;
    --h2: #7bc96f;
    --h3: #3d9a50;
    --h4: #1f6a33;
    --claude: #d97757;
    --codex: #10a37f;
    --cursor: #6b7cff;
  }

  :global(:root[data-theme='dark']) .activity {
    --h0: #ffffff0d;
    --h1: #0e4429;
    --h2: #006d32;
    --h3: #26a641;
    --h4: #39d353;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .activity {
      --h0: #ffffff0d;
      --h1: #0e4429;
      --h2: #006d32;
      --h3: #26a641;
      --h4: #39d353;
    }
  }

  .note {
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .fine-note {
    margin: 0.5rem 0 0 !important;
    font-size: 0.75rem;
    color: var(--faint);
  }

  /* ---------- stat tiles ---------- */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .stats.three {
    grid-template-columns: repeat(3, 1fr);
  }

  .stats :global(.stat) {
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--chip);
  }

  .stats :global(.stat b) {
    display: block;
    font-family: 'Instrument Serif', ui-serif, Georgia, serif;
    font-size: 1.85rem;
    font-weight: 400;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .stats :global(.stat span) {
    font-size: 0.78rem;
    color: var(--faint);
  }

  /* ---------- tool split ---------- */
  .split {
    margin-bottom: 1.25rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .split :global(.bar) {
    display: flex;
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--line);
    margin-bottom: 0.5rem;
  }

  .split :global(.bar i) {
    display: block;
    height: 100%;
  }

  .split :global(.keys) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
  }

  .split :global(.dot) {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 0.35em;
    border-radius: 50%;
  }

  /* ---------- year tabs ---------- */
  .tabs {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 0.6rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  .tabs :global(button) {
    flex: none;
    padding: 0.2rem 0.65rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    color: var(--faint);
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
  }

  .tabs :global(button:hover) {
    color: var(--fg);
  }

  .tabs :global(button[aria-selected='true']) {
    border-color: var(--line);
    background: var(--chip);
    color: var(--fg);
  }

  /* ---------- heatmap ---------- */
  .heat-wrap {
    margin: 0;
  }

  .heat {
    display: grid;
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    grid-auto-columns: minmax(9px, 1fr);
    gap: 3px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .heat::-webkit-scrollbar {
    display: none;
  }

  .heat :global(i),
  .legend i {
    display: block;
    aspect-ratio: 1;
    min-width: 9px;
    border-radius: 2px;
    background: var(--h0);
  }

  .heat :global(i[data-l='1']),
  .legend i[data-l='1'] { background: var(--h1); }
  .heat :global(i[data-l='2']),
  .legend i[data-l='2'] { background: var(--h2); }
  .heat :global(i[data-l='3']),
  .legend i[data-l='3'] { background: var(--h3); }
  .heat :global(i[data-l='4']),
  .legend i[data-l='4'] { background: var(--h4); }

  .heat :global(i.pad) {
    visibility: hidden;
  }

  .heat :global(i[data-d]) {
    cursor: default;
  }

  .heat :global(i[data-d]:hover) {
    outline: 1.5px solid var(--fg);
    outline-offset: 1px;
  }

  :global(.heat-tip) {
    position: fixed;
    z-index: 50;
    max-width: min(320px, calc(100vw - 24px));
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    box-shadow: var(--shadow);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--fg);
    pointer-events: none;
  }

  :global(.heat-tip[hidden]) {
    display: none;
  }

  :global(.heat-tip b) {
    display: block;
    margin-bottom: 0.15rem;
    font-weight: 600;
  }

  :global(.heat-tip .row) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
  }

  :global(.heat-tip .row span:last-child) {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  :global(.heat-tip .sep) {
    margin: 0.35rem 0 0.2rem;
    font-size: 0.7rem;
    color: var(--faint);
  }

  :global(.heat-tip .gh) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--faint);
  }

  .legend {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .legend i {
    width: 10px;
    min-width: 10px;
  }

  /* ---------- daily log ---------- */
  .log {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .log :global(li) {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    /* 日期和标题字号、行高不同，按第一行文字的基线对齐，不按盒子顶边 */
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--line);
  }

  .log :global(li:first-child) {
    border-top: 0;
    padding-top: 0;
  }

  .log :global(time) {
    white-space: nowrap;
    font-family: 'Instrument Serif', ui-serif, Georgia, serif;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  :global(html[data-lang='zh']) .log :global(time) {
    font-family: ui-sans-serif, -apple-system, 'PingFang SC', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .log :global(time small) {
    display: block;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--faint);
  }

  .log :global(.what) {
    margin: 0 0 0.2rem;
  }

  .log :global(.detail) {
    margin: 0 0 0.45rem;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .log :global(.meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .log :global(.tag) {
    padding: 0.1em 0.55em;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--muted);
    white-space: nowrap;
  }

  /* ---------- models ---------- */
  .sources {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0.25rem 0 1rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .sources :global(b) {
    color: var(--fg);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .models {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .models :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.3rem 0.75rem;
    align-items: baseline;
  }

  .models :global(.m-name) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .models :global(.m-name > span) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .models :global(.m-dot) {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .models :global(.m-icon) {
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    object-fit: contain;
  }

  .models :global(.m-mask) {
    border-radius: 0;
    background: currentColor;
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }

  .models :global(.m-val) {
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    white-space: nowrap;
  }

  .models :global(.m-bar) {
    grid-column: 1 / -1;
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--line);
  }

  .models :global(.m-bar i) {
    display: block;
    height: 100%;
    border-radius: 999px;
  }

  .models :global(.m-name small) {
    flex: none;
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--faint);
  }

  /* ---------- 日报里的当天 GitHub 动态 ---------- */
  .log :global(.gh) {
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
  }

  .log :global(.gh li) {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    min-width: 0;
    padding: 0.12rem 0;
    border: 0;
  }

  .log :global(.gh li[hidden]) {
    display: none;
  }

  .log :global(.gh .k) {
    flex: none;
    min-width: 2.6rem;
    font-size: 0.7rem;
    color: var(--faint);
  }

  .log :global(.gh a) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted);
  }

  .log :global(.gh a b) {
    font-weight: 600;
    color: var(--fg);
  }

  .log :global(.gh-more) {
    margin-top: 0.2rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }

  /* ---------- recent activity ---------- */
  .sub {
    margin: 1.5rem 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
  }

  .feed {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feed :global(li) {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.4rem 0;
    font-size: 0.85rem;
    border-top: 1px dashed var(--line);
  }

  .feed :global(li:first-child) {
    border-top: 0;
  }

  .feed :global(.kind) {
    font-size: 0.72rem;
    color: var(--faint);
  }

  .feed :global(.what) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .feed :global(.what span) {
    color: var(--muted);
  }

  .feed :global(time) {
    font-size: 0.75rem;
    color: var(--faint);
    white-space: nowrap;
  }

  /* ---------- open source timeline ---------- */
  .timeline {
    position: relative;
    margin: 0;
    padding: 0 0 0 1.25rem;
    list-style: none;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0.4rem;
    bottom: 0.4rem;
    left: 0.3rem;
    width: 1px;
    background: var(--line);
  }

  .timeline :global(.year) {
    position: relative;
    margin: 1.25rem 0 0.4rem;
    font-family: 'Instrument Serif', ui-serif, Georgia, serif;
    font-size: 1.25rem;
    color: var(--muted);
  }

  .timeline :global(.year:first-child) {
    margin-top: 0;
  }

  .timeline :global(.item) {
    position: relative;
  }

  .timeline :global(.item::before) {
    content: '';
    position: absolute;
    top: 1.05rem;
    left: calc(-1.25rem + 0.3rem - 3.5px);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 0 1.5px var(--faint);
  }

  .timeline :global(a) {
    display: block;
    margin: 0 -0.5rem;
    padding: 0.6rem 0.5rem;
    border-radius: 12px;
    transition: background-color 0.15s ease;
  }

  .timeline :global(a:hover) {
    background: var(--chip);
  }

  .timeline :global(.head) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.6rem;
  }

  .timeline :global(.name) {
    font-weight: 600;
    font-size: 0.92rem;
  }

  .timeline :global(.name span) {
    font-weight: 400;
    color: var(--muted);
  }

  .timeline :global(.meta) {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    color: var(--faint);
  }

  .timeline :global(.own) {
    padding: 0.05em 0.5em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 500;
  }

  .timeline :global(.stars) {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .timeline :global(.star) {
    color: #e3b341;
  }

  .timeline :global(.title) {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .timeline :global(time) {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--faint);
    white-space: nowrap;
  }

  .more {
    display: block;
    margin: 0.75rem 0 0 1.25rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--chip);
    color: var(--muted);
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .more[hidden] {
    display: none;
  }

  .more:hover {
    background: var(--chip-hover);
    color: var(--fg);
  }

  @media (max-width: 480px) {
    .stats:not(.three) {
      grid-template-columns: repeat(2, 1fr);
    }

    .log :global(li) {
      grid-template-columns: 4.6rem minmax(0, 1fr);
      gap: 0.75rem;
    }

    .feed :global(li) {
      grid-template-columns: 3rem minmax(0, 1fr);
    }

    .feed :global(time) {
      display: none;
    }
  }
</style>

<script>
  // 交互：年份切换、热力图悬停详情、日报「展开」、模型「全部 / 近 30 天」、开源「展示更多」。
  // 数据用构建时嵌进页面的那一份（和 HTML 里已经渲染好的内容同源）；构建时没取到才现取接口兜底。
  import type { Lang, Profile } from '../activity/view'
  import { createView } from '../activity/view'

  const root = document.querySelector<HTMLElement>('.activity')!
  const lang = (root.dataset.lang === 'zh' ? 'zh' : 'en') as Lang
  const slot = (name: string) => root.querySelector<HTMLElement>(`[data-slot="${name}"]`)!

  // 悬停详情：整页一个浮层，热力图格子带 data-d（日期）
  const tip = document.createElement('div')
  tip.className = 'heat-tip'
  tip.hidden = true
  document.body.appendChild(tip)
  function showTip(cell: HTMLElement, html: string) {
    tip.innerHTML = html
    tip.hidden = false
    const r = cell.getBoundingClientRect()
    const w = tip.offsetWidth
    const h = tip.offsetHeight
    const left = Math.min(Math.max(8, r.left + r.width / 2 - w / 2), window.innerWidth - w - 8)
    const top = r.top - h - 8 < 8 ? r.bottom + 8 : r.top - h - 8
    tip.style.left = `${left}px`
    tip.style.top = `${top}px`
  }
  window.addEventListener('scroll', () => (tip.hidden = true), { passive: true })

  /** 手机上横向滚动的热力图默认停在最近的日子 */
  function scrollHeat(el: HTMLElement) {
    requestAnimationFrame(() => (el.scrollLeft = el.scrollWidth))
  }

  /** 把一份 view 的初始内容写进各个 slot（只在构建时没渲染的兜底情况下用） */
  function fill(slots: Record<string, { html?: string, text?: string, hidden?: boolean }>) {
    for (const [name, s] of Object.entries(slots)) {
      const el = slot(name)
      if (!el)
        continue
      if (s.html !== undefined)
        el.innerHTML = s.html
      if (s.text !== undefined)
        el.textContent = s.text
      if (s.hidden !== undefined)
        el.hidden = s.hidden
    }
  }

  function bind(p: Profile) {
    const v = createView(lang).build(p)

    const heatTabs = (tabsName: string, heatName: string, captionName: string, view: typeof v.codeView, tipFn: (d: string) => string) => {
      const tabs = slot(tabsName)
      const heat = slot(heatName)
      tabs.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button')
        if (!btn)
          return
        tabs.querySelectorAll('button').forEach(b => b.setAttribute('aria-selected', String(b === btn)))
        const out = view(btn.dataset.key!)
        heat.innerHTML = out.heat
        slot(captionName).textContent = out.caption
        scrollHeat(heat)
      })
      const handler = (e: Event) => {
        const cell = (e.target as HTMLElement).closest<HTMLElement>('i[data-d]')
        if (cell)
          showTip(cell, tipFn(cell.dataset.d!))
      }
      heat.addEventListener('mouseover', handler)
      heat.addEventListener('click', handler)
      heat.addEventListener('mouseleave', () => (tip.hidden = true))
      scrollHeat(heat)
    }
    heatTabs('code-tabs', 'code-heat', 'code-caption', v.codeView, v.codeTip)
    heatTabs('ai-tabs', 'ai-heat', 'ai-caption', v.aiView, v.aiTip)

    // 日报里当天 GitHub 动态的「展开 / 收起」
    slot('log').addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.gh-more')
      if (!btn)
        return
      const list = btn.previousElementSibling as HTMLElement
      const open = btn.dataset.open !== '1'
      list.querySelectorAll<HTMLElement>('[data-extra]').forEach(li => (li.hidden = !open))
      btn.dataset.open = open ? '1' : '0'
      const { L } = createView(lang)
      btn.textContent = open ? L.collapse : L.expand(Number(btn.dataset.n))
    })

    const tabs = slot('models-tabs')
    tabs.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button')
      if (!btn)
        return
      tabs.querySelectorAll('button').forEach(b => b.setAttribute('aria-selected', String(b === btn)))
      const out = v.modelsView(btn.dataset.range as 'all' | 'month')
      slot('models-sources').innerHTML = out.sources
      slot('models').innerHTML = out.list
    })

    let shown = v.initialShown
    slot('more').addEventListener('click', () => {
      shown = Math.min(v.itemCount, shown + 10)
      const out = v.timelineView(shown)
      slot('timeline').innerHTML = out.html
      slot('more').hidden = out.rest <= 0
      slot('more').textContent = out.more
    })
  }

  const embedded = root.querySelector('script[data-activity]')?.textContent
  if (embedded) {
    bind(JSON.parse(embedded) as Profile)
  }
  else {
    // 兜底：构建时没拿到数据，现取接口渲染
    fetch(root.dataset.api!, { cache: 'no-cache' })
      .then(r => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then((p: Profile) => {
        fill(createView(lang).build(p).slots)
        bind(p)
        root.hidden = false
      })
      .catch(e => console.warn('[activity] 数据加载或渲染失败：', e))
  }
</script>
